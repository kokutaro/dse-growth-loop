  "components": {
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SkillCandidate": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "skillCandidate"
          },
          "fragmentId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "sourceFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceInputState": {
            "enum": [
              "extracted",
              "unknown",
              "not_evaluated"
            ]
          },
          "item": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpecificSkill"
              },
              {
                "type": "null"
              }
            ]
          },
          "element": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SkillElement"
              },
              {
                "type": "null"
              }
            ]
          },
          "dictionaryVersionAtCollection": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "pending",
              "matched",
              "registered",
              "alias",
              "merged",
              "not_skill",
              "deferred",
              "collection_held"
            ]
          },
          "conceptId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 50,
            "uniqueItems": true
          },
          "reviewedDictionaryVersion": {
            "type": "integer",
            "minimum": 0
          },
          "candidateType": {
            "enum": [
              "collection"
            ]
          },
          "holdReasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "fragmentId",
          "sourceFingerprint",
          "sourceInputState",
          "item",
          "element",
          "dictionaryVersionAtCollection",
          "state",
          "conceptId",
          "history"
        ],
        "allOf": [
          {
            "$ref": "#/components/schemas/PersistedMetadata"
          },
          {
            "if": {
              "required": [
                "candidateType"
              ],
              "properties": {
                "candidateType": {
                  "const": "collection"
                }
              }
            },
            "then": {
              "required": [
                "holdReasons"
              ],
              "properties": {
                "state": {
                  "const": "collection_held"
                },
                "item": {
                  "type": "null"
                },
                "element": {
                  "type": "null"
                },
                "conceptId": {
                  "type": "null"
                },
                "history": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "item": {
                  "$ref": "#/components/schemas/SpecificSkill"
                },
                "element": {
                  "$ref": "#/components/schemas/SkillElement"
                },
                "state": {
                  "not": {
                    "const": "collection_held"
                  }
                }
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "SpecificSkill": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "raw": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "normalizationCandidate": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "participation": {
            "enum": [
              "performed",
              "joint",
              "assisted",
              "consultation",

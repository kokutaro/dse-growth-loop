            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "現在状態または操作結果",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "description": "入力不正"
          },
          "401": {
            "description": "認証必要"
          },
          "403": {
            "description": "現在のoperator権限が必要"
          },
          "404": {
            "description": "根拠・候補・辞書版へのアクセスなし"
          },
          "409": {
            "description": "重複・状態・別名・種別・スコープの競合または根拠更新"
          },
          "412": {
            "description": "候補ETagまたは辞書版が古い。人の再確認が必要"
          },
          "413": {
            "description": "原子バッチの上限"
          },
          "422": {
            "description": "明示した処理上限"
          },
          "429": {
            "description": "既存レート制限"
          },
          "503": {
            "description": "依存先またはフェンスが利用不可"
          }
        }
      }

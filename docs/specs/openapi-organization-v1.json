          },
          "403": {
            "description": "operator必要"
          },
          "404": {
            "description": "対象不明"
          },
          "409": {
            "description": "部署ID再利用・利用中・冪等キー競合"
          },
          "412": {
            "description": "古いETagまたはauthorityToken"
          },
          "503": {
            "description": "正本不明・maintenance・フェンス閉鎖"
          }
        }
      }
    },
    "/api/v1/me/organization": {

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OrganizationChange": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "change"
            ],
            "properties": {
              "type": {
                "const": "department"
              },
              "change": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "validFrom",
                  "validTo",
                  "successorIds",
                  "reason",
                  "expectedAuthorityToken"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "validFrom": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "validTo": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "successorIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "uniqueItems": true,
                    "maxItems": 20
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "expectedAuthorityToken": {
                    "type": "string",
                    "minLength": 34,
                    "maxLength": 64
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "change"
            ],
            "properties": {
              "type": {
                "const": "membership"
              },
              "change": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "personId",
                  "terms",
                  "reason",
                  "expectedAuthorityToken"
                ],
                "properties": {
                  "personId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "terms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "termId",
                        "departmentId",
                        "from",
                        "to"
                      ],
                      "properties": {
                        "termId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "departmentId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "from": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "to": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "maxItems": 100
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "expectedAuthorityToken": {
                    "type": "string",
                    "minLength": 34,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}

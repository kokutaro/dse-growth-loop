    "/api/v1/sessions/{sid}/knowledge": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "保存／再取得成功"
          },
          "400": {
            "description": "不正入力"
          },
          "401": {
            "description": "認証必要"
          },
          "403": {
            "description": "操作権限なし"
          },
          "404": {
            "description": "現在の会話参加者ではない"
          },
          "409": {
            "description": "承認版／同意／状態競合"
          },
          "412": {
            "description": "ETag不一致"
          },
          "413": {
            "description": "入力上限"
          },
          "429": {
            "description": "要求数制限"
          },
          "503": {
            "description": "依存障害／フェンス閉鎖"
          }
        }
      }
    },

          "503": {
            "description": "依存障害／フェンス閉鎖"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "enum": [
                            "challenge",
                            "assumptions",
                            "attempts",
                            "result",
                            "reuseConditions",
                            "unresolvedPoints"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1500
                        },
                        "basis": {
                          "enum": [
                            "participant_report",
                            "inference",
                            "unknown"
                          ]
                        },
                        "evidenceIds": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                          },
                          "uniqueItems": true,
                          "maxItems": 20
                        }
                      },
                      "required": [
                        "field",
                        "text",
                        "basis",
                        "evidenceIds"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 6,
                    "maxItems": 6
                  },
                  "scopeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 20,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "sections",
                  "scopeIds"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },

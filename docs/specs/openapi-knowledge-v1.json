  "components": {
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "主体・メソッド・正規化パス・キー単位で24時間保持。同一body hashは同一結果、異なるbodyは409。",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "GETで取得した強いETag。欠落400、不一致412。*は不可。",
        "schema": {
          "type": "string",
          "pattern": "^\"[^\"\\r\\n]+\"$"
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }

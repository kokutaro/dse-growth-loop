            "p50Ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p95Ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "cold3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedCount",
            "observedCount",
            "p50Ms",
            "p95Ms",

              ],
              "minimum": 0
            },
            "p95Ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "warmSearch22": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedCount",
            "observedCount",
            "p50Ms",
            "p95Ms"
          ],
          "properties": {
            "expectedCount": {
              "const": 22
            },
            "observedCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0

                  "p95Ms": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 15000
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cost": {
            "properties": {
              "monthlyGate": {
                "const": "passed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "cost": {
            "properties": {
              "unknownComponents": {
                "maxItems": 0
              },
              "estimatedMonthlyTotalJpy": {
                "type": "number",
                "minimum": 0,
                "maximum": 8000
              },
              "components": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceKind": {
            "const": "real_service"
          }
        }
      },
      "then": {
        "properties": {
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "provenance": {
            "properties": {
              "sourceSha256": {
                "type": "string",
                "minLength": 1

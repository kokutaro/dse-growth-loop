      "required": [
        "method",
        "warmAll24",
        "warmSearch22",
        "cold3",
        "warmP95LimitMs",
        "warmGate"
      ],
      "properties": {
        "method": {
          "const": "linear_interpolation_ranks_(n-1)*p"
        },
        "warmAll24": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedCount",
            "observedCount",
            "p50Ms",
            "p95Ms"
          ],
          "properties": {
            "expectedCount": {
              "const": 24
            },
            "observedCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "p50Ms": {
              "type": [
                "number",

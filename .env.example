# シェル構文・変数展開は使いません。既存の環境変数が .env より優先されます。
# ローカル起動。Demo は Development 環境でのみ許可。
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
Data__Mode=Demo
ASPNETCORE_URLS=http://localhost:5180

# Azure 展開先（RG は dse-growth-loop-rg 固定）
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=japaneast
FOUNDRY_LOCATION=japaneast
IMAGE_TAG=initial

# 単一テナントの SPA/API アプリ登録。API は v2 access token を使用。
Auth__TenantId=
Auth__ClientId=
Auth__AllowedObjectIds__0=
# Auth__AllowedObjectIds__1=

# ローカルから Azure データに接続する場合は Data__Mode=Azure に変更。
Cosmos__Endpoint=
Cosmos__Database=dse-growth-loop
Storage__BlobEndpoint=
Storage__QueueEndpoint=
KeyVault__Uri=
Foundry__Endpoint=
Foundry__Deployment=
FOUNDRY_MODEL_NAME=
FOUNDRY_MODEL_VERSION=
FOUNDRY_MODEL_SKU=GlobalStandard
FOUNDRY_MODEL_CAPACITY=1

# AI アダプターは次工程で実装。秘密値は UI/VITE_* に渡しません。
Jev__Endpoint=https://api.typesafe.ai/v1/systemone
Jev__Model=jev-1.13.0
Jev__SecretName=jev-api-key
Jev__ApiKey=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# シェル構文・変数展開は使いません。既存の環境変数が .env より優先されます。
# ローカル起動。Demo は Development 環境でのみ許可。
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
Data__Mode=Demo
ASPNETCORE_URLS=http://localhost:5180

# Azure 展開先（RG は dse-growth-loop-rg 固定）
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=japaneast
FOUNDRY_LOCATION=japaneast
IMAGE_TAG=initial

# 単一テナントの SPA/API アプリ登録。API は v2 access token を使用。
Auth__TenantId=
Auth__ClientId=
Auth__AllowedObjectIds__0=
# Auth__AllowedObjectIds__1=
# Azureモードでは許可oidごとにサーバー側BindingとGrantも必要。未設定なら403。
# 実際のTenantId/Oidは.envだけに設定し、gitへ保存しない。
# Auth__Bindings__0__TenantId=<Auth__TenantIdと同じ値>
# Auth__Bindings__0__Oid=<Auth__AllowedObjectIds__0と同じ値>
# Auth__Bindings__0__PrincipalId=principal-demo-01
# Auth__Bindings__0__PersonId=demo-person-01
# Auth__Bindings__0__Roles__0=member
# Auth__Bindings__0__Enabled=true
# Auth__Grants__0__PrincipalId=principal-demo-01
# Auth__Grants__0__ScopeIds__0=demo

# ローカルから Azure データに接続する場合は Data__Mode=Azure に変更。
Cosmos__Endpoint=
Cosmos__Database=dse-growth-loop
Storage__BlobEndpoint=
Storage__QueueEndpoint=
KeyVault__Uri=
Foundry__Endpoint=
Foundry__Deployment=
FOUNDRY_MODEL_NAME=
FOUNDRY_MODEL_VERSION=
FOUNDRY_MODEL_SKU=GlobalStandard
FOUNDRY_MODEL_CAPACITY=1

# AIポートの既定はMock＋停止。Liveは別途承認とopt-inが必要。
Ai__Mode=Mock
AiUsage__LiveOptIn=false
AiUsage__MaxInputTokens=8000
AiUsage__MaxOutputTokens=1000
AiUsage__MaxConcurrency=1
AiUsage__MaxAttempts=2
AiUsage__TimeoutSeconds=30
# Foundryは実契約の正確な応答model ID/版/リージョン/従量SKU/上限を確認して固定。
# 候補Luna、Terraは明示比較のみ。別モデルへの自動fallbackなし。
Foundry__ModelId=
Foundry__ModelVersion=
Foundry__Region=
Foundry__Sku=
Foundry__OutputLimit=
Foundry__InputUsdPerMillion=
Foundry__OutputUsdPerMillion=
# キー本文は.envにも不要。Managed IdentityでKey Vaultの固定版を取得。
Jev__Endpoint=https://api.typesafe.ai/v1/systemone
Jev__Model=jev-1.13.0
Jev__SecretName=jev-api-key
Jev__SecretVersion=
Jev__InputUsdPerMillion=
Jev__OutputUsdPerMillion=0
Jev__OutputLimit=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# 費用ガード。10000円/月（税別）は申請案であり、承認額ではありません。
# 0は未承認。有料操作には正の承認額と --confirm-cost が必要。
APPROVED_MONTHLY_BUDGET_JPY=0
AZURE_BUDGET_EMAILS=
# 請求通貨JPYのRG Budget用。作成時の月初を指定（例: 2026-09-01）。
AZURE_BUDGET_START_DATE=
AZURE_BUDGET_CURRENCY=JPY
# ログ1 GB/月は想定量。日次capとは別。capでも厳密な請求上限は保証しません。
LOGS_DAILY_QUOTA_GB=0.05
LOGS_RETENTION_DAYS=30
APP_LOG_LEVEL=Warning
TELEMETRY_SAMPLING_PERCENTAGE=10
# ローカル.NETへ直接指定する場合（配置は上記から変換）
# Telemetry__SamplingPercentage=10
BLOB_VERSIONING_ENABLED=true
BLOB_SOFT_DELETE_DAYS=7
# 以下は手動レビュー用の保持方針タグ。自動削除・定期purgeはしません。
BLOB_HISTORY_REVIEW_DAYS=30
ACR_KEEP_LATEST_TAGS=3
ACR_MINIMUM_IMAGE_AGE_DAYS=30

# UTC日次。予約＋確定使用量を永続台帳で制限。既定では送信しません。
AI_STOPPED=true
AI_DAILY_TOKEN_LIMIT=0
AI_DAILY_CALL_LIMIT=0
AI_DAILY_ESTIMATED_JPY_LIMIT=0
AI_USD_TO_JPY=0
AI_PRICE_VERSION=
AI_FX_VERSION=

# Office取込WorkerをAzureへ配置する場合のみ明示（有料実行は別途承認）
DEPLOY_INGESTION_WORKER=false
Ingestion__OriginalBytes=10485760
Ingestion__ExpandedBytes=52428800
Ingestion__Entries=10000
Ingestion__ProcessingSeconds=120
Ingestion__Attempts=3
